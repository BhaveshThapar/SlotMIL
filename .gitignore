.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Data, caches and run outputs live in scratch and are never committed.
#
# Leading slash matters: a bare `data/` matches a directory named `data` at ANY
# depth, which silently excluded the entire `slotmil/data/` source package --
# feature_cache.py, lidc.py, mosmed.py, medmnist3d.py were untracked for several
# commits. Anchor these to the repo root so they only ever match the top-level
# data/, runs/ and logs/ directories.
# data/ is excluded except for the split manifests. `prereg_freeze.py --check`
# verifies every declared split's hash and exits 1 if it cannot find one, so
# without these a fresh clone cannot run the check the paper points readers at.
# They are ~472 KB of public series UIDs and patient grouping -- no image data --
# and committing them also lets a reader confirm the test set was never trained
# on, rather than take it on trust.
/data/*
!/data/lidc/
/data/lidc/*
!/data/lidc/splits*.json
!/data/mosmed/
/data/mosmed/*
!/data/mosmed/splits*.json
/logs/

# runs/ is excluded except for the stamped analysis artefacts, which are the
# paper's evidence and are named in its abstract. Committing them is what makes
# "the analysis plan and its amendment chain ship with the code" checkable from a
# clone: `prereg_freeze.py --check` walks runs/**/*.json, and prereg_verdict.py
# recomputes nothing -- it reads only these files. ~4.3 MB in total.
#
# The attention dumps themselves (*.npz, 13+ GB) stay out. A re-include cannot
# resurrect a file under an excluded *directory*, so runs/ is excluded by its
# contents (`/runs/*`) rather than as a directory.
/runs/*
!/runs/nulls_*_confirmatory/
/runs/nulls_*_confirmatory/*
!/runs/nulls_*_confirmatory/*.json
!/runs/prereg/
/runs/prereg/*
!/runs/prereg/unblind_key.json
# H3's two inputs, which live at the top level rather than under a condition.
!/runs/untrained_floor_rehash5.json
!/runs/untrained_floor_mh_rehash5.json
# The Harvey bridge lives outside the confirmatory directories on purpose --
# it carries exploratory MosMed rows -- but its artefact is paper evidence.
!/runs/harvey_bridge/
/runs/harvey_bridge/*
!/runs/harvey_bridge/harvey_bridge.json
# The confound atlas: exploratory per-dataset profiles, MELBA-version evidence.
!/runs/confound_atlas/
/runs/confound_atlas/*
!/runs/confound_atlas/*.json
/wandb/
*.h5
*.pt
*.ckpt
env/setup.log
# Anchored, for the reason spelled out above: a bare `docs/` matches a directory
# named docs at ANY depth. The pre-registration deliberately lives at the repo
# root rather than in here, because a record that cannot be committed is not one.
/docs/
